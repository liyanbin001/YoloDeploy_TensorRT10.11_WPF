<Window x:Class="YoloDeploy.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YOLOv8 TensorRT Deploy"
        Width="1280"
        Height="940"
        MinWidth="1050"
        MinHeight="800"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Phase 1: ONNX -> Engine -->
        <GroupBox Grid.Row="0"
                  Header="ONNX → TensorRT Engine"
                  Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="95"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="95"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="ONNX 文件"/>

                <TextBox x:Name="OnnxPathTextBox"
                         Grid.Row="0"
                         Grid.Column="1"
                         Margin="8,4"/>

                <Button Grid.Row="0"
                        Grid.Column="2"
                        Margin="4"
                        Padding="12,6"
                        Content="浏览..."
                        Click="BrowseOnnx_Click"/>

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="Engine 输出"/>

                <TextBox x:Name="EngineOutputPathTextBox"
                         Grid.Row="1"
                         Grid.Column="1"
                         Margin="8,4"/>

                <Button Grid.Row="1"
                        Grid.Column="2"
                        Margin="4"
                        Padding="12,6"
                        Content="另存为..."
                        Click="BrowseEngineOutput_Click"/>

                <StackPanel Grid.Row="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Margin="0,6,0,4"
                            Orientation="Horizontal">

                    <TextBlock VerticalAlignment="Center"
                               Text="输入尺寸"/>

                    <TextBox x:Name="BuildInputSizeTextBox"
                             Width="70"
                             Margin="8,0,20,0"
                             Text="640"/>

                    <TextBlock VerticalAlignment="Center"
                               Text="精度"/>

                    <ComboBox x:Name="PrecisionComboBox"
                              Width="90"
                              Margin="8,0,20,0"
                              SelectedIndex="0">
                        <ComboBoxItem Content="FP32"/>
                        <ComboBoxItem Content="FP16"/>
                    </ComboBox>

                    <TextBlock VerticalAlignment="Center"
                               Text="Workspace MiB"/>

                    <TextBox x:Name="WorkspaceTextBox"
                             Width="90"
                             Margin="8,0,20,0"
                             Text="2048"/>

                    <Button x:Name="BuildEngineButton"
                            Width="140"
                            Padding="10,6"
                            Content="生成 Engine"
                            Click="BuildEngine_Click"/>
                </StackPanel>

                <TextBox x:Name="BuildLogTextBox"
                         Grid.Row="3"
                         Grid.Column="0"
                         Grid.ColumnSpan="3"
                         Height="82"
                         Margin="0,5,0,0"
                         Padding="6"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Text="尚未执行 ONNX → Engine 构建。"/>
            </Grid>
        </GroupBox>

        <!-- Existing engine / image selection -->
        <Border Grid.Row="1"
                Margin="0,12,0,0"
                Padding="14"
                BorderBrush="#D7D7D7"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="Engine"/>
                <TextBox x:Name="EnginePathTextBox"
                         Grid.Row="0" Grid.Column="1"
                         Margin="8,4"/>
                <Button Grid.Row="0" Grid.Column="2"
                        Margin="4"
                        Padding="12,6"
                        Content="浏览..."
                        Click="BrowseEngine_Click"/>

                <TextBlock Grid.Row="1" Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="图片"/>
                <TextBox x:Name="ImagePathTextBox"
                         Grid.Row="1" Grid.Column="1"
                         Margin="8,4"/>
                <Button Grid.Row="1" Grid.Column="2"
                        Margin="4"
                        Padding="12,6"
                        Content="浏览..."
                        Click="BrowseImage_Click"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2"
                    Margin="0,12,0,0"
                    Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" Text="置信度"/>
            <TextBox x:Name="ConfidenceTextBox"
                     Width="70"
                     Margin="8,0,20,0"
                     Text="0.25"/>

            <TextBlock VerticalAlignment="Center" Text="NMS IoU"/>
            <TextBox x:Name="NmsTextBox"
                     Width="70"
                     Margin="8,0,20,0"
                     Text="0.45"/>

            <TextBlock VerticalAlignment="Center" Text="动态输入尺寸"/>
            <TextBox x:Name="InputSizeTextBox"
                     Width="70"
                     Margin="8,0,20,0"
                     Text="640"/>

            <Button x:Name="LoadModelButton"
                    Width="110"
                    Margin="4,0"
                    Padding="10,6"
                    Content="加载模型"
                    Click="LoadModel_Click"/>

            <Button x:Name="DetectButton"
                    Width="110"
                    Margin="4,0"
                    Padding="10,6"
                    Content="执行检测"
                    Click="Detect_Click"/>
        </StackPanel>

        <TextBlock x:Name="ModelInfoTextBlock"
                   Grid.Row="3"
                   Margin="0,10,0,10"
                   Foreground="#555555"
                   TextWrapping="Wrap"
                   Text="模型尚未加载。"/>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderBrush="#D7D7D7"
                    BorderThickness="1"
                    CornerRadius="8"
                    Background="#111111">
                <Viewbox Stretch="Uniform">
                    <Grid x:Name="ImageSurface"
                          Width="640"
                          Height="480"
                          Background="Black">
                        <Image x:Name="PreviewImage"
                               Stretch="Fill"/>
                        <Canvas x:Name="OverlayCanvas"
                                IsHitTestVisible="False"/>
                    </Grid>
                </Viewbox>
            </Border>

            <Border Grid.Column="1"
                    Margin="12,0,0,0"
                    BorderBrush="#D7D7D7"
                    BorderThickness="1"
                    CornerRadius="8">
                <DataGrid x:Name="DetectionGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="45"/>
                        <DataGridTextColumn Header="类别" Binding="{Binding ClassName}" Width="*"/>
                        <DataGridTextColumn Header="置信度" Binding="{Binding ScoreText}" Width="75"/>
                        <DataGridTextColumn Header="坐标" Binding="{Binding BoxText}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <StatusBar Grid.Row="5" Margin="0,12,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusTextBlock" Text="就绪"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
