<Window x:Class="YoloDeploy.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YOLO TensorRT Deploy - Detect / OBB / Seg + MinRect"
        Width="1320"
        Height="950"
        MinWidth="1080"
        MinHeight="780"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0"
                  Header="GPU / Runtime"
                  Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="GpuInfoTextBlock"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Text="正在读取 GPU 信息..."/>

                <Button x:Name="RefreshGpuInfoButton"
                        Grid.Column="1"
                        Width="90"
                        Margin="12,0,0,0"
                        Padding="10,5"
                        Content="刷新"
                        Click="RefreshGpuInfo_Click"/>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="1"
                  Margin="0,10,0,0"
                  Header="ONNX → TensorRT Engine"
                  Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="95"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="95"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="ONNX 文件"/>

                <TextBox x:Name="OnnxPathTextBox"
                         Grid.Row="0"
                         Grid.Column="1"
                         Margin="8,4"/>

                <Button Grid.Row="0"
                        Grid.Column="2"
                        Margin="4"
                        Padding="12,6"
                        Content="浏览..."
                        Click="BrowseOnnx_Click"/>

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="Engine 输出"/>

                <TextBox x:Name="EngineOutputPathTextBox"
                         Grid.Row="1"
                         Grid.Column="1"
                         Margin="8,4"/>

                <Button x:Name="BrowseEngineOutputButton"
                        Grid.Row="1"
                        Grid.Column="2"
                        Margin="4"
                        Padding="12,6"
                        Content="另存为..."
                        Click="BrowseEngineOutput_Click"/>

                <StackPanel Grid.Row="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Margin="0,6,0,4"
                            Orientation="Horizontal">

                    <TextBlock VerticalAlignment="Center"
                               Text="固定输入宽度"/>

                    <TextBox x:Name="BuildInputWidthTextBox"
                             Width="70"
                             Margin="8,0,14,0"
                             Text="640"
                             TextChanged="CacheParameter_TextChanged"/>

                    <TextBlock VerticalAlignment="Center"
                               Text="固定输入高度"/>

                    <TextBox x:Name="BuildInputHeightTextBox"
                             Width="70"
                             Margin="8,0,20,0"
                             Text="640"
                             TextChanged="CacheParameter_TextChanged"/>

                    <TextBlock VerticalAlignment="Center"
                               Text="精度"/>

                    <ComboBox x:Name="PrecisionComboBox"
                              Width="90"
                              Margin="8,0,20,0"
                              SelectedIndex="0"
                              SelectionChanged="CacheParameter_SelectionChanged">
                        <ComboBoxItem Content="FP32"/>
                        <ComboBoxItem Content="FP16"/>
                    </ComboBox>

                    <TextBlock VerticalAlignment="Center"
                               Text="Workspace MiB"/>

                    <TextBox x:Name="WorkspaceTextBox"
                             Width="90"
                             Margin="8,0,20,0"
                             Text="2048"
                             TextChanged="CacheParameter_TextChanged"/>

                    <Button x:Name="BuildEngineButton"
                            Width="150"
                            Padding="10,6"
                            Content="生成 / 使用 Engine"
                            Click="BuildEngine_Click"/>
                </StackPanel>

                <StackPanel Grid.Row="3"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Margin="0,5,0,0"
                            Orientation="Horizontal">

                    <CheckBox x:Name="UseEngineCacheCheckBox"
                              VerticalAlignment="Center"
                              IsChecked="True"
                              Content="使用本机 Engine 缓存"
                              Checked="CacheOption_Changed"
                              Unchecked="CacheOption_Changed"/>

                    <CheckBox x:Name="ForceRebuildCheckBox"
                              Margin="20,0,0,0"
                              VerticalAlignment="Center"
                              Content="强制重新构建"/>

                    <Button Margin="24,0,0,0"
                            Padding="10,4"
                            Content="打开缓存目录"
                            Click="OpenCache_Click"/>

                    <Button Margin="8,0,0,0"
                            Padding="10,4"
                            Content="清空缓存"
                            Click="ClearCache_Click"/>

                    <TextBlock x:Name="CacheStatsTextBlock"
                               Margin="20,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#555555"
                               Text="缓存：--"/>
                </StackPanel>

                <TextBlock x:Name="CacheStatusTextBlock"
                           Grid.Row="4"
                           Grid.Column="0"
                           Grid.ColumnSpan="3"
                           Margin="0,6,0,0"
                           Foreground="#355C8A"
                           TextWrapping="Wrap"
                           Text="缓存状态：等待选择 ONNX。"/>

                <TextBox x:Name="BuildLogTextBox"
                         Grid.Row="5"
                         Grid.Column="0"
                         Grid.ColumnSpan="3"
                         Height="78"
                         Margin="0,6,0,0"
                         Padding="6"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Text="尚未执行 ONNX → Engine 构建。"/>
            </Grid>
        </GroupBox>

        <Border Grid.Row="2"
                Margin="0,10,0,0"
                Padding="14"
                BorderBrush="#D7D7D7"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="Engine"/>

                <TextBox x:Name="EnginePathTextBox"
                         Grid.Row="0"
                         Grid.Column="1"
                         Margin="8,4"/>

                <Button Grid.Row="0"
                        Grid.Column="2"
                        Margin="4"
                        Padding="12,6"
                        Content="浏览..."
                        Click="BrowseEngine_Click"/>

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="图片"/>

                <TextBox x:Name="ImagePathTextBox"
                         Grid.Row="1"
                         Grid.Column="1"
                         Margin="8,4"/>

                <Button Grid.Row="1"
                        Grid.Column="2"
                        Margin="4"
                        Padding="12,6"
                        Content="浏览..."
                        Click="BrowseImage_Click"/>
            </Grid>
        </Border>

        <WrapPanel Grid.Row="3"
                   Margin="0,10,0,0"
                   Orientation="Horizontal">

            <TextBlock VerticalAlignment="Center"
                       Text="模型任务"/>

            <ComboBox x:Name="ModelTaskComboBox"
                      Width="220"
                      Margin="8,0,20,0"
                      SelectedIndex="0">
                <ComboBoxItem Content="普通检测 Detect"/>
                <ComboBoxItem Content="旋转框 OBB"/>
                <ComboBoxItem Content="实例分割 Seg → 多任务"/>
            </ComboBox>

            <TextBlock VerticalAlignment="Center"
                       Text="置信度"/>

            <TextBox x:Name="ConfidenceTextBox"
                     Width="70"
                     Margin="8,0,20,0"
                     Text="0.25"/>

            <TextBlock VerticalAlignment="Center"
                       Text="NMS 阈值"/>

            <TextBox x:Name="NmsTextBox"
                     Width="70"
                     Margin="8,0,20,0"
                     Text="0.45"/>

            <TextBlock VerticalAlignment="Center"
                       Text="Mask阈值"/>

            <TextBox x:Name="MaskThresholdTextBox"
                     Width="70"
                     Margin="8,0,20,0"
                     Text="0.50"/>

            <CheckBox x:Name="ShowMaskCheckBox"
                      Margin="4,0,12,0"
                      VerticalAlignment="Center"
                      IsChecked="True"
                      Content="显示Mask"/>

            <CheckBox x:Name="ShowBBoxCheckBox"
                      Margin="4,0,12,0"
                      VerticalAlignment="Center"
                      IsChecked="True"
                      Content="显示水平框"/>

            <CheckBox x:Name="ShowMinRectCheckBox"
                      Margin="4,0,20,0"
                      VerticalAlignment="Center"
                      IsChecked="True"
                      Content="显示最小外接矩形"/>

            <TextBlock VerticalAlignment="Center"
                       Text="Engine宽度"/>

            <TextBox x:Name="InputWidthTextBox"
                     Width="70"
                     Margin="8,0,14,0"
                     Text="640"/>

            <TextBlock VerticalAlignment="Center"
                       Text="Engine高度"/>

            <TextBox x:Name="InputHeightTextBox"
                     Width="70"
                     Margin="8,0,20,0"
                     Text="640"/>

            <Button x:Name="LoadModelButton"
                    Width="110"
                    Margin="4,0"
                    Padding="10,6"
                    Content="加载模型"
                    Click="LoadModel_Click"/>

            <Button x:Name="DetectButton"
                    Width="110"
                    Margin="4,0"
                    Padding="10,6"
                    Content="执行检测"
                    Click="Detect_Click"/>
        </WrapPanel>

        <TextBlock x:Name="ModelInfoTextBlock"
                   Grid.Row="4"
                   Margin="0,8,0,8"
                   Foreground="#555555"
                   TextWrapping="Wrap"
                   Text="模型尚未加载。"/>

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderBrush="#D7D7D7"
                    BorderThickness="1"
                    CornerRadius="8"
                    Background="#111111">
                <Viewbox Stretch="Uniform">
                    <Grid x:Name="ImageSurface"
                          Width="640"
                          Height="480"
                          Background="Black">
                        <Image x:Name="PreviewImage"
                               Stretch="Fill"/>

                        <Image x:Name="MaskOverlayImage"
                               Stretch="Fill"
                               Opacity="0.42"
                               IsHitTestVisible="False"/>

                        <Canvas x:Name="OverlayCanvas"
                                ClipToBounds="True"
                                IsHitTestVisible="False"/>
                    </Grid>
                </Viewbox>
            </Border>

            <Border Grid.Column="1"
                    Margin="12,0,0,0"
                    BorderBrush="#D7D7D7"
                    BorderThickness="1"
                    CornerRadius="8">
                <DataGrid x:Name="DetectionGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#"
                                            Binding="{Binding Index}"
                                            Width="45"/>
                        <DataGridTextColumn Header="类别"
                                            Binding="{Binding ClassName}"
                                            Width="*"/>
                        <DataGridTextColumn Header="置信度"
                                            Binding="{Binding ScoreText}"
                                            Width="75"/>
                        <DataGridTextColumn Header="坐标"
                                            Binding="{Binding BoxText}"
                                            Width="170"/>
                        <DataGridTextColumn Header="角度"
                                            Binding="{Binding AngleText}"
                                            Width="75"/>
                        <DataGridTextColumn Header="Mask面积"
                                            Binding="{Binding AreaText}"
                                            Width="95"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <StatusBar Grid.Row="6"
                   Margin="0,10,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusTextBlock"
                           Text="就绪"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
